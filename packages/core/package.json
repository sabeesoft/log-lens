{
  "name": "@sabeesoft/loglens-core",
  "version": "0.1.0",
  "description": "Framework-agnostic log parsing core for Log Lens — detect format and parse JSON / NDJSON / CSV (incl. Java toString() notation) into plain records. Runs in the browser and in Node, with zero host-app or DOM dependencies.",
  "license": "Apache-2.0",
  "author": "sabeesoft",
  "repository": {
    "type": "git",
    "url": "https://github.com/sabeesoft/log-lens.git"
  },
  "keywords": [
    "logs",
    "log-parser",
    "ndjson",
    "csv",
    "json",
    "java-notation",
    "browser"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "csv-parse": "^6.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
