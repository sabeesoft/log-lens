{
  "name": "log-lens",
  "displayName": "Log lens",
  "description": "Log lens a simple local tool to visualize JSON logs",
  "version": "1.3.0",
  "publisher": "sabeesoft",
  "icon": "assets/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sabeesoft/log-lens.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "log-lens.openLogFile",
        "title": "Log Lens: Open Log File…",
        "icon": "$(folder-opened)"
      },
      {
        "command": "log-lens.loadCurrentFile",
        "title": "Log Lens: Load Current JSON File"
      },
      {
        "command": "log-lens.loadLogFile",
        "title": "Log Lens: Load Log File (NDJSON)"
      },
      {
        "command": "log-lens.loadCsvFile",
        "title": "Log Lens: Load CSV File"
      },
      {
        "command": "log-lens.openFromExplorer",
        "title": "Open with Log Lens"
      },
      {
        "command": "log-lens.openRecent",
        "title": "Log Lens: Open Recent File"
      },
      {
        "command": "log-lens.clearRecent",
        "title": "Log Lens: Clear Recent Files",
        "icon": "$(clear-all)"
      },
      {
        "command": "log-lens.showErrors",
        "title": "Log Lens: Show Parse Errors"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "logLens",
          "title": "Log Lens",
          "icon": "assets/logo/activitybar.svg"
        }
      ]
    },
    "views": {
      "logLens": [
        {
          "id": "logLens.recent",
          "name": "Recent"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "logLens.recent",
        "contents": "Open a JSON, NDJSON or CSV log to get started.\n[Open Log File…](command:log-lens.openLogFile)\nYou can also right-click a file in the Explorer and choose \"Open with Log Lens\"."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "log-lens.openLogFile",
          "when": "view == logLens.recent",
          "group": "navigation"
        },
        {
          "command": "log-lens.clearRecent",
          "when": "view == logLens.recent",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "log-lens.openFromExplorer",
          "when": "resourceExtname =~ /^\\.(json|log|ndjson|csv)$/",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "log-lens.openFromExplorer",
          "when": "false"
        },
        {
          "command": "log-lens.openRecent",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "install:all": "npm install && cd webview-ui && npm install",
    "start:webview": "cd webview-ui && npm run start",
    "build:webview": "cd webview-ui && npm run build",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/glob": "^7.1.3",
    "@types/node": "^12.11.7",
    "@types/vscode": "^1.46.0",
    "@typescript-eslint/eslint-plugin": "^4.14.1",
    "@typescript-eslint/parser": "^4.14.1",
    "eslint": "^7.19.0",
    "glob": "^7.1.6",
    "prettier": "^2.2.1",
    "typescript": "^4.1.3",
    "vscode-test": "^1.5.0"
  },
  "dependencies": {
    "csv-parse": "^6.1.0"
  }
}
