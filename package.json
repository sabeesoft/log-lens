{
  "name": "log-lens",
  "displayName": "Log lens",
  "description": "Log lens a simple local tool to visualize JSON logs",
  "version": "2.1.2",
  "publisher": "sabeesoft",
  "icon": "assets/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sabeesoft/log-lens.git"
  },
  "homepage": "https://sabeesoft.com/en/loglens",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "log-lens.openLogFile",
        "title": "Log Lens: Open Log File…",
        "icon": "$(folder-opened)"
      },
      {
        "command": "log-lens.loadCurrentFile",
        "title": "Log Lens: Load Current JSON File"
      },
      {
        "command": "log-lens.loadLogFile",
        "title": "Log Lens: Load Log File (NDJSON)"
      },
      {
        "command": "log-lens.loadCsvFile",
        "title": "Log Lens: Load CSV File"
      },
      {
        "command": "log-lens.openFromExplorer",
        "title": "Open with Log Lens"
      },
      {
        "command": "log-lens.openRecent",
        "title": "Log Lens: Open Recent File"
      },
      {
        "command": "log-lens.clearRecent",
        "title": "Log Lens: Clear Recent Files",
        "icon": "$(clear-all)"
      },
      {
        "command": "log-lens.showErrors",
        "title": "Log Lens: Show Parse Errors"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "logLens",
          "title": "Log Lens",
          "icon": "assets/logo/activitybar.svg"
        }
      ]
    },
    "views": {
      "logLens": [
        {
          "id": "logLens.recent",
          "name": "Recent"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "logLens.recent",
        "contents": "Open a JSON, NDJSON or CSV log to get started.\n[Open Log File…](command:log-lens.openLogFile)\nYou can also right-click a file in the Explorer and choose \"Open with Log Lens\"."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "log-lens.openLogFile",
          "when": "view == logLens.recent",
          "group": "navigation"
        },
        {
          "command": "log-lens.clearRecent",
          "when": "view == logLens.recent",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "log-lens.openFromExplorer",
          "when": "resourceExtname =~ /^\\.(json|log|ndjson|csv)$/",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "log-lens.openFromExplorer",
          "when": "false"
        },
        {
          "command": "log-lens.openRecent",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "install:all": "npm install && cd webview-ui && npm install",
    "start:webview": "cd webview-ui && npm run start",
    "build:webview": "cd webview-ui && npm run build",
    "vscode:prepublish": "npm run typecheck && npm run clean && npm run bundle",
    "clean": "rm -rf out",
    "bundle": "esbuild src/extension.ts --bundle --minify --sourcemap --platform=node --target=node16 --format=cjs --external:vscode --outfile=out/extension.js",
    "bundle:watch": "esbuild src/extension.ts --bundle --sourcemap --platform=node --target=node16 --format=cjs --external:vscode --outfile=out/extension.js --watch",
    "typecheck": "tsc --noEmit -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.46.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.1"
  },
  "dependencies": {
    "@sabeesoft/loglens-core": "file:./packages/core"
  }
}
